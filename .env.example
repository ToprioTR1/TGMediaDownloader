# Telegram bot tokeni (@BotFather'dan alinir) - ZORUNLU
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin kullanici id'leri, virgulle ayrilir (örn: 123456789,987654321)
ADMIN_IDS=123456789

# Ayni anda kac indirme calissin (VPS icin 2-3 ideal)
CONCURRENCY=2

# Telegram'in izin verdigi maksimum dosya boyutu (MB).
# Bulut API = 50, yerel Bot API sunucusu kullaniyorsan 2000 yapabilirsin.
MAX_UPLOAD_MB=50

# Bu cozunurlugun ustundeki formatlar secilmez (0 = sinirsiz)
MAX_HEIGHT=0

# Kalite belirtilmeyen linklerde kullanilacak varsayilan cozunurlukler.
# Istek uzerine en yakin mevcut kalite secilir (orn. TikTok 1012 -> 1024p).
QUALITY_INSTAGRAM=1280
QUALITY_TIKTOK=1012
QUALITY_YOUTUBE=720
QUALITY_DEFAULT=720

# Izin verilen maksimum video suresi (saniye, 0 = sinirsiz)
MAX_DURATION_SEC=1800

# Bir kullanicinin ayni anda kuyrukta tutabilecegi is sayisi
MAX_QUEUE_PER_USER=3

# Gunluk indirme limiti (0 = sinirsiz)
DAILY_LIMIT=20

# Iki istek arasinda beklenecek minimum sure (saniye)
COOLDOWN_SEC=10

# Instagram/TikTok gibi girisi zorunlu platformlar icin cookies dosyasi
# (bos birakilirsa kullanilmaz)
COOKIES_FILE=/data/cookies.txt

# Buyuk medya yuklemeleri icin Telegram istek zaman asimi (saniye).
# Yavas baglantilarda veya yerel Bot API ile 2GB dosyalarda artirin.
UPLOAD_TIMEOUT_SEC=600

# Indirilen dosyanin file_id'si onbellekte tutulur; ayni video tekrar
# istendiginde yeniden indirilmeden aninda gonderilir. 0 = kapali.
CACHE_DAYS=30

# Instagram fotoğraf / carousel destegi (gallery-dl). 0 = kapali.
GALLERY_ENABLED=1

# Tek bir gonderide en fazla kac medya indirilsin (Telegram album limiti 10)
GALLERY_LIMIT=10

# Konteyner her acilista yt-dlp + gallery-dl'yi guncellesin (Docker icin).
# Yerel calistirmada kullanilmaz. 0 = kapali.
AUTO_UPDATE_YTDLP=1

# Yerel Bot API sunucusu (50MB ustu dosyalar icin). Bos = bulut API.
# TELEGRAM_API_URL=http://bot-api:8081
# Yerel Bot API icin my.telegram.org'dan alinan bilgiler:
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Gerekirse HTTP(S) proxy (örn: http://127.0.0.1:1080)
# PROXY_URL=

DOWNLOAD_DIR=/data/downloads
DB_PATH=/data/bot.db
LOG_LEVEL=INFO
